# Flask / Lehrerbereich
SECRET_KEY=change-this-before-deployment
LEHRER_PASSWORD=change-this-before-deployment
# In Coolify hinter HTTPS auf 1 setzen; lokal per HTTP auf 0 lassen.
SESSION_COOKIE_SECURE=0

# KI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
DAILY_TOKEN_LIMIT=50000

# Verschlüsselte IServ-WebDAV-Sicherung (optional)
# Die Werte aus der schulischen Verzeichnisstruktur sind bereits eingetragen.
ISERV_WEBDAV_URL=https://webdav.gsm-w.de
ISERV_WEBDAV_USERNAME=
ISERV_WEBDAV_PASSWORD=
ISERV_BACKUP_PATH=Files/Backups_AB_KI

# URL-safe Base64, entschlüsselt genau 32 Byte. Niemals in Git einchecken.
ISERV_BACKUP_ENCRYPTION_KEY=
ISERV_TIMEOUT_SECONDS=15

# Optional: Pfad zu einer zusätzlichen vertrauenswürdigen CA-Datei im Container.
# Die TLS-Prüfung wird nicht abgeschaltet.
ISERV_CA_BUNDLE=
