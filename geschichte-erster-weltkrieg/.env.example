# Flask / Lehrerbereich
SECRET_KEY=change-this-before-deployment
LEHRER_PASSWORD=change-this-before-deployment
# In Coolify hinter HTTPS auf 1 setzen; lokal per HTTP auf 0 lassen.
SESSION_COOKIE_SECURE=0

# KI (optional) – ohne Schlüssel bleiben alle Aufgaben nutzbar,
# KI-Tutor und KI-Feedback zeigen dann einen Hinweis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
DAILY_TOKEN_LIMIT=50000

# Optional: eigener Pfad zur SQLite-Datei (Standard: data/weltkrieg.db)
# DB_PATH=
# Auf 1 setzen, wenn Sitzungsdaten einen Neustart überleben sollen (Standard: DSGVO-Löschung beim Start)
KEEP_SESSION_DATA=0
